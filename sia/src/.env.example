# SIA Frontend Environment
# Vercel / Local Development

# WebSocket backend URL (for real-time indexer alerts)
# Vercel is serverless and does NOT support persistent WebSocket.
# You MUST deploy server.js to an external host (Railway, Render, VPS)
# and put that URL here. Example:
# VITE_INDEXER_WS_URL=wss://sia-backend.railway.app/indexer-ws
VITE_INDEXER_WS_URL=

# Fallback: if WS is empty or fails, the app auto-switches to short-polling.
# This ensures the UI still works on Vercel without a separate backend.

# Helius RPC Key (optional — used by frontend direct RPC calls)
VITE_HELIUS_API_KEY=

# Smart wallets registry (comma-separated wallet:name:type:x)
VITE_SMART_WALLETS=

# Birdeye API key untuk cross-validation harga (proxy backend pakai BIRDEYE_API_KEY).
# Tanpa key, endpoint public Birdeye masih jalan tapi quota lebih ketat.
VITE_BIRDEYE_API_KEY=

# Supabase Auth (login dengan X). Nilai di bawah ini AMAN untuk frontend
# karena anon key memang dirancang public (security via RLS di Postgres).
# Service role JWT / secret key TIDAK BOLEH masuk file ini.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-here
